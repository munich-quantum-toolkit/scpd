// The seven stage artifacts of a run directory, 01-capacity.fb through
// 07-geometry.fb. Owned by MQT::ScpdIO. Grids and router containers are
// derived state and never appear here.
//
// Each stage appends the fields of its output when the stage is implemented,
// so the tables of stages that do not exist yet are empty on purpose.

include "design.fbs";
include "geometry.fbs";

namespace mqt.scpd.flatbuffers.artifacts;

/// A grid of a run, as the numbers that convert between its cells and layout
/// units. The grid itself is derived state and is rebuilt; these six numbers
/// are what a reader needs to place what the artifact does carry.
table GridExtent {
  width: uint32;
  height: uint32;
  origin: geometry.Point (required, native_inline);
  cell_width: double;
  cell_height: double;
}

/// One partition of the free space, as the watershed left it.
table Partition {
  label: uint32;
  /// Closed rings in layout units. More than one where the partition has a
  /// hole, or the watershed left it in pieces.
  outlines: [geometry.Polygon] (required);
}

/// Where two partitions meet, and how many wires may cross there.
table PartitionBorder {
  first: uint32;
  second: uint32;
  /// The cell edges the border runs along, in layout units.
  samples: [geometry.Point] (required);
  center: geometry.Point (required, native_inline);
  budget: uint32;
}

/// The narrowest place of a corridor: the two obstacle points that face each
/// other across it, and how many wires fit between them.
table Bottleneck {
  from: geometry.Point (required, native_inline);
  to: geometry.Point (required, native_inline);
  capacity: uint32;
}

/// A launcher and the point at which its wires enter the chip.
table LauncherSlot {
  port: design.PortRef (required, native_inline);
  position: geometry.Point (required, native_inline);
}

/// What one link of a capacity chain stands for.
enum CapacityElement : ubyte {
  Unset,
  /// A port the chain has to serve.
  Target,
  /// A gate the wires beyond it have to pass.
  Bottleneck,
  /// The launcher the chain is rooted at.
  Launcher,
}

/// One link of a capacity chain.
///
/// A chain is a tree and FlatBuffers has no recursive table, so the nodes are
/// stored flat and a link names its branches by index. That also lets two
/// chains share a subtree without storing it twice.
table CapacityNode {
  kind: CapacityElement;
  /// The port for a Target and the index into `bottlenecks` for a
  /// Bottleneck. Unused for a Launcher.
  id: uint32;
  /// How many wires this link lets through. Only a Bottleneck limits.
  capacity: uint32;
  /// Indices into CapacityPlan.nodes.
  next: [uint32] (required);
}

/// Output of the Capacity stage.
table CapacityPlan {
  capacity_grid: GridExtent (required);
  detail_grid: GridExtent (required);
  partitions: [Partition] (required);
  borders: [PartitionBorder] (required);
  bottlenecks: [Bottleneck] (required);
  launchers: [LauncherSlot] (required);
  nodes: [CapacityNode] (required);
  /// The index in `nodes` of each chain's root.
  chains: [uint32] (required);
  /// What the ports' own approaches keep clear, as closed rings in layout
  /// units: the strip a wire leaves each routable port along, extended
  /// forward and backward, and the square each launcher sweeps.
  ///
  /// These are obstacles to everything the stages route, and they are not
  /// chip artwork, which is why they are a layer of their own rather than
  /// more polygons in the chip. Only the cells that were free before a band
  /// took them are here; where a band merely covered artwork the artwork is
  /// already drawn. The rings follow the cells, so a band along a diagonal
  /// is the staircase the grid actually blocks.
  port_keepout: [geometry.Polygon];
}

/// One lattice the inner circuit is solved on: the Hanan grid that the ports
/// of one capacity chain induce.
table Lattice {
  points: [geometry.Point] (required);
  /// Two point indices per edge, flat.
  edges: [uint32] (required);
  /// The edges the solution selected, as indices into `edges` divided by two.
  selected: [uint32] (required);
}

/// Output of the Global stage. The lattices are empty when the chip has no
/// inner circuit, which is a valid state rather than a skipped stage.
table GlobalRouting {
  lattices: [Lattice] (required);
  /// The inner-circuit connections the solved flow implies.
  connections: [design.Connection] (required);
  /// The outer port ring the Assignment stage consumes. The inner circuit
  /// extends the configured ring with the coupler ports it surfaces at, so
  /// this is what the assignment reads and not the configuration.
  outer_ring: [design.PortRef] (required);
  /// The resonator ports the assignment has to give a launcher.
  resonators: [design.PortRef] (required);
  objective: double;
}

/// Output of the Assignment stage.
table Assignment {
  /// One connection per node of `ring`, in the order of `ring`. A
  /// conventional port runs from the launcher it was given, as
  /// `FeedlineSource` to `FeedlineTarget`. A resonator carries
  /// `ResonatorSource` to `ResonatorTarget` and no source port, because the
  /// port that feeds it is the coupler the Final stage inserts.
  connections: [design.Connection] (required);
  objective: double;
  /// The ring the model consumed, in the order it consumed it.
  ring: [design.PortRef] (required);
  /// The launcher each ring node was given, parallel to `ring`.
  launchers: [design.PortRef] (required);
  /// Where each ring node is actually fed from, parallel to `ring`.
  ///
  /// A conventional port is fed at the launcher slot `launchers` names, and
  /// no two of them share one. A resonator is fed at no launcher at all: the
  /// wire that reaches it comes past the slot, so its feed sits on the
  /// segment from its own launcher to the next launcher along. Where a
  /// launcher was given n resonators they divide that segment evenly, in
  /// ring order.
  feeds: [geometry.Point] (required);
}

/// The crossing slots of one partition border.
///
/// A wire leaves one partition for another at one of these, and no two wires
/// take the same one. The slots sit one wire spacing apart along the border,
/// so their count is what the border can carry, which is what
/// `PartitionBorder.budget` reports.
table BorderSlots {
  /// The border they belong to, as an index into CapacityPlan.borders, or
  /// zero when `pocket` is set and they are on no border at all.
  border: uint32;
  /// The slots in layout units, in the order the border runs.
  positions: [geometry.Point] (required);
  /// Whether these are ways out of a port's own pocket rather than slots of a
  /// border.
  ///
  /// The capacity grid places a target on the first cell beyond its port's
  /// band that was free before the bands, and does not open the band. Where
  /// the band and the artwork close around a port, the free space left is a
  /// pocket that no border reaches; the band is that port's own approach, so
  /// it is a way out, and it carries the one wire.
  pocket: bool = false;
}

/// The coarse route of one connection: which partitions it passes through,
/// and where it crosses from each into the next.
table Corridor {
  /// The labels of the partitions, from the one the wire is fed in to the
  /// one its target sits in. These are `Partition.label` values, not indices
  /// into `CapacityPlan.partitions`.
  partitions: [uint32] (required);
  /// The crossing slots between them, in layout units. One shorter than
  /// `partitions`.
  crossings: [geometry.Point] (required);
  /// Where the wire starts: the cell the feed of the assignment was placed
  /// at. Absent when the connection has no feed the grid can reach.
  source: geometry.Point;
  /// Where it ends: the cell its target port is reached at. Absent when the
  /// chip has no such cell.
  target: geometry.Point;
}

/// Output of the Corridor stage.
///
/// One entry per connection of the Assignment, in its order. A connection
/// the stage could not route carries no partitions, so a reader counts the
/// failures rather than being handed a separate list that can disagree with
/// the routes beside it.
table CorridorRouting {
  corridors: [Corridor] (required);
  /// The slots of every border a wire could cross, so a picture can show
  /// which of them are taken. Parallel to nothing: a border with no free
  /// space on either side has no entry.
  slots: [BorderSlots] (required);
}

/// One wire's path on the detail grid, cell by cell.
///
/// The cells are eight-connected and run from the point the wire is fed at to
/// the cell its target port is reached at. A wire the stage could not draw
/// carries no cells, so a reader counts the failures rather than being handed
/// a separate list that can disagree with the paths beside it.
table DetailWire {
  path: [geometry.DCoord] (required);
}

/// Output of the Detail stage.
///
/// `wires` has one entry per connection of the Assignment, in its order, so it
/// lines up with `CorridorRouting.corridors` without a key. `inner` has one
/// entry per connection of the Global stage, in its order: those never entered
/// the corridor stage, because they paid for the free space they cross while
/// the inner circuit was solved.
table DetailRouting {
  /// The grid the cells are counted on, so a reader can place them without
  /// rebuilding the run.
  grid: GridExtent (required);
  wires: [DetailWire] (required);
  inner: [DetailWire] (required);
}

/// Output of the Final stage. The couplers carry the ports they create and
/// the connections they complete, so a reloaded run can rebuild the grown
/// port list and the completed connections without the stage.
table FinalRouting {
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
  /// The connections that did not route.
  unresolved: [design.ConnectionRef] (required);
}

/// One connection's wire in its exact analytic form.
table Wire {
  connection: design.ConnectionRef (required, native_inline);
  path: geometry.Path (required);
}

/// Output of the Finalize stage: the geometry IR.
table Geometry {
  wires: [Wire] (required);
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
}

/// What a stage produces.
union StageOutput {
  CapacityPlan,
  Assignment,
  GlobalRouting,
  DetailRouting,
  FinalRouting,
  Geometry,
  CorridorRouting,
}

/// The root of every stage artifact.
table Artifact {
  /// The mqt-scpd version that wrote the artifact, for provenance.
  producer: string (required);
  output: StageOutput (required);
}

root_type Artifact;

// The identifier records the schema version. Change the digit on an
// incompatible schema change, so that loading an artifact written by an
// incompatible version fails with a clear message rather than misreading it.
file_identifier "SCP1";
file_extension "fb";
