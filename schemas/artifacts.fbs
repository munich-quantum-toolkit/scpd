// The stage artifacts of a run directory, 01-capacity.fb through
// 07-geometry.fb. Owned by MQT::ScpdIO. Grids and router containers are
// derived state and never appear here.
//
// Each stage appends the fields of its output when the stage is implemented,
// so the tables of stages that do not exist yet are empty on purpose.

include "design.fbs";

namespace mqt.scpd.flatbuffers.artifacts;

/// A grid of a run, as the numbers that convert between its cells and layout
/// units. The grid itself is derived state and is rebuilt; these numbers are
/// what a reader needs to place what the artifact carries.
table GridExtent {
  width: uint32;
  height: uint32;
  origin: geometry.Point (required, native_inline);
  cell_width: double;
  cell_height: double;
}

/// One partition of the free space.
table Partition {
  label: uint32;
  /// Closed rings in layout units. More than one where the partition has a
  /// hole. The cells of a partition are four-connected, so a wire can cross
  /// it from any of its borders to any other.
  outlines: [geometry.Polygon] (required);
}

/// Where two partitions meet, and how many wires may cross there.
table PartitionBorder {
  first: uint32;
  second: uint32;
  /// The cell edges the border runs along, in layout units.
  samples: [geometry.Point] (required);
  center: geometry.Point (required, native_inline);
  budget: uint32;
}

/// The narrowest place of a corridor: the two obstacle points that face each
/// other across it, and how many wires fit between them.
table Bottleneck {
  from: geometry.Point (required, native_inline);
  to: geometry.Point (required, native_inline);
  capacity: uint32;
}

/// A launcher and the point at which its wires enter the chip.
table LauncherSlot {
  port: design.PortRef (required, native_inline);
  position: geometry.Point (required, native_inline);
}

/// What one link of a capacity chain stands for.
enum CapacityElement : ubyte {
  Unset,
  /// A port the chain has to serve.
  Target,
  /// A gate the wires beyond it have to pass.
  Bottleneck,
  /// The launcher the chain starts at.
  Launcher,
}

/// One link of a capacity chain.
///
/// A chain is a tree and FlatBuffers has no recursive table, so the nodes are
/// stored flat and a link names its branches by index. Two chains can then
/// share a subtree without storing it twice. A target lies on one chain only,
/// so a shared subtree holds no target.
table CapacityNode {
  kind: CapacityElement;
  /// The port of a Target and the index into `bottlenecks` of a Bottleneck.
  /// Unused for a Launcher.
  id: uint32;
  /// How many wires this link lets through. Only a Bottleneck limits.
  capacity: uint32;
  /// Indices into CapacityPlan.nodes.
  next: [uint32] (required);
}

/// Output of the Capacity stage.
table CapacityPlan {
  capacity_grid: GridExtent (required);
  detail_grid: GridExtent (required);
  partitions: [Partition] (required);
  borders: [PartitionBorder] (required);
  bottlenecks: [Bottleneck] (required);
  launchers: [LauncherSlot] (required);
  nodes: [CapacityNode] (required);
  /// The index in `nodes` of the root of each chain.
  chains: [uint32] (required);
  /// What the approaches of the ports keep clear, as closed rings in layout
  /// units: the strip a wire leaves each routable port along, extended
  /// forward and backward.
  ///
  /// These are obstacles to everything the stages route, and they are not
  /// chip artwork, so they are a layer of their own rather than more
  /// polygons of the chip. Only the cells that were free before a band took
  /// them are here; where a band covers artwork, the artwork is already
  /// drawn. The rings follow the cells, so a band along a diagonal is the
  /// staircase the grid blocks.
  port_keepout: [geometry.Polygon];
}

/// Output of the Assignment stage.
table Assignment {
  connections: [design.Connection] (required);
  objective: double;
}

/// Output of the Global stage. Empty when the chip has no inner circuit.
table GlobalRouting {}

/// Output of the Detail stage.
table DetailRouting {}

/// Output of the Final stage. The couplers carry the ports they create and
/// the connections they complete, so a reloaded run can rebuild the grown
/// port list and the completed connections without the stage.
table FinalRouting {
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
  /// The connections that did not route.
  unresolved: [design.ConnectionRef] (required);
}

/// One connection's wire in its exact analytic form.
table Wire {
  connection: design.ConnectionRef (required, native_inline);
  path: geometry.Path (required);
}

/// Output of the Finalize stage: the geometry IR.
table Geometry {
  wires: [Wire] (required);
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
}

/// What a stage produces.
union StageOutput {
  CapacityPlan,
  Assignment,
  GlobalRouting,
  DetailRouting,
  FinalRouting,
  Geometry,
}

/// The root of every stage artifact.
table Artifact {
  /// The mqt-scpd version that wrote the artifact, for provenance.
  producer: string (required);
  output: StageOutput (required);
}

root_type Artifact;

// The identifier records the schema version. Change the digit on an
// incompatible schema change, so that loading an artifact written by an
// incompatible version fails with a clear message rather than misreading it.
file_identifier "SCP1";
file_extension "fb";
