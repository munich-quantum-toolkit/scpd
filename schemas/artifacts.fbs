// The stage artifacts of a run directory, 01-capacity.fb through
// 07-geometry.fb. Owned by MQT::ScpdIO. Grids and router containers are
// derived state and never appear here.
//
// Each stage appends the fields of its output when the stage is implemented,
// so the tables of stages that do not exist yet are empty on purpose.

include "design.fbs";

namespace mqt.scpd.flatbuffers.artifacts;

/// A grid of a run, as the numbers that convert between its cells and layout
/// units. The grid itself is derived state and is rebuilt; these numbers are
/// what a reader needs to place what the artifact carries.
table GridExtent {
  width: uint32;
  height: uint32;
  origin: geometry.Point (required, native_inline);
  cell_width: double;
  cell_height: double;
}

/// One partition of the free space.
table Partition {
  label: uint32;
  /// Closed rings in layout units. More than one where the partition has a
  /// hole. The cells of a partition are four-connected, so a wire can cross
  /// it from any of its borders to any other.
  outlines: [geometry.Polygon] (required);
}

/// Where two partitions meet, and how many wires may cross there.
table PartitionBorder {
  first: uint32;
  second: uint32;
  /// The cell edges the border runs along, in layout units.
  samples: [geometry.Point] (required);
  center: geometry.Point (required, native_inline);
  budget: uint32;
}

/// The narrowest place of a corridor: the two obstacle points that face each
/// other across it, and how many wires fit between them.
table Bottleneck {
  from: geometry.Point (required, native_inline);
  to: geometry.Point (required, native_inline);
  capacity: uint32;
}

/// A launcher and the point at which its wires enter the chip.
table LauncherSlot {
  port: design.PortRef (required, native_inline);
  position: geometry.Point (required, native_inline);
}

/// What one link of a capacity chain stands for.
enum CapacityElement : ubyte {
  Unset,
  /// A port the chain has to serve.
  Target,
  /// A gate the wires beyond it have to pass.
  Bottleneck,
  /// The launcher the chain starts at.
  Launcher,
}

/// One link of a capacity chain.
///
/// A chain is a tree and FlatBuffers has no recursive table, so the nodes are
/// stored flat and a link names its branches by index. Two chains can then
/// share a subtree without storing it twice. A target lies on one chain only,
/// so a shared subtree holds no target.
table CapacityNode {
  kind: CapacityElement;
  /// The port of a Target and the index into `bottlenecks` of a Bottleneck.
  /// Unused for a Launcher.
  id: uint32;
  /// How many wires this link lets through. Only a Bottleneck limits.
  capacity: uint32;
  /// Indices into CapacityPlan.nodes.
  next: [uint32] (required);
}

/// Output of the Capacity stage.
table CapacityPlan {
  capacity_grid: GridExtent (required);
  detail_grid: GridExtent (required);
  partitions: [Partition] (required);
  borders: [PartitionBorder] (required);
  bottlenecks: [Bottleneck] (required);
  launchers: [LauncherSlot] (required);
  nodes: [CapacityNode] (required);
  /// The index in `nodes` of the root of each chain.
  chains: [uint32] (required);
  /// What the approaches of the ports keep clear, as closed rings in layout
  /// units: the strip a wire leaves each routable port along, extended
  /// forward and backward.
  ///
  /// These are obstacles to everything the stages route, and they are not
  /// chip artwork, so they are a layer of their own rather than more
  /// polygons of the chip. Only the cells that were free before a band took
  /// them are here; where a band covers artwork, the artwork is already
  /// drawn. The rings follow the cells, so a band along a diagonal is the
  /// staircase the grid blocks.
  port_keepout: [geometry.Polygon];
}

/// Output of the Assignment stage.
table Assignment {
  /// One connection per node of `ring`, in the order of `ring`. A
  /// conventional port runs from the launcher it was given, as
  /// FeedlineSource to FeedlineTarget. A resonator carries ResonatorSource
  /// to ResonatorTarget and no source port, because the port that feeds it is
  /// the coupler that the Final stage inserts.
  connections: [design.Connection] (required);
  objective: double;
  /// The ring the model consumed, in the order it consumed it.
  ring: [design.PortRef] (required);
  /// The launcher each ring node was given, parallel to `ring`.
  launchers: [design.PortRef] (required);
  /// Where each ring node is fed from, parallel to `ring`.
  ///
  /// A conventional port is fed at the launcher slot that `launchers` names.
  /// A resonator is fed at no launcher: the wire that reaches it comes past
  /// the slot, so its feed sits on the segment between its own launcher and a
  /// neighboring one. The resonators fed on one segment divide it evenly, in
  /// the order the walk of the ring reaches them. No two feeds lie closer than
  /// the wire spacing.
  feeds: [geometry.Point] (required);
  /// The feedline chains the model chose: which resonators one feedline
  /// drives, from one launcher to the next. The Final stage routes each of
  /// them from its first launcher through the couplers of its resonators to
  /// its last.
  chains: [FeedlineChain] (required);
}

/// One feedline chain of the assignment.
///
/// The model gives every resonator degree two on the ring: a chord to the
/// resonator before it, a chord to the one after it, or an end. An end is a
/// launcher, or one of the permitted terminations where the feedline stops.
/// A chain is a run of resonators joined by chords, and the Final stage
/// drives it with one feedline: launcher, coupler, coupler, …, launcher. A
/// chain has a launcher at one end at least; its other end may be a
/// termination.
table FeedlineChain {
  /// The ring nodes the chain runs through, as indices into `ring` and
  /// `connections`, in ring order. Every one of them is a resonator.
  nodes: [uint32] (required);
  /// The launcher the chain starts at: the launcher slot its first resonator
  /// was given. Absent where the chain starts at a termination.
  start: design.PortRef;
  /// The launcher the chain ends at: the launcher slot its last resonator
  /// was given. Absent where the chain ends at a termination.
  end: design.PortRef;
}

/// One lattice the inner circuit is solved on: the Hanan grid that the ports
/// of one capacity chain induce.
table Lattice {
  points: [geometry.Point] (required);
  /// Two point indices per edge, flat.
  edges: [uint32] (required);
  /// The edges of the connections, as indices into `edges` divided by two.
  /// The edges of a wire that the connections leave out are not among them.
  selected: [uint32] (required);
}

/// Output of the Global stage. The lattices are empty when the chip has no
/// inner circuit, which is a valid state rather than a skipped stage.
table GlobalRouting {
  lattices: [Lattice] (required);
  /// The connections of the inner circuit that the solved flow implies. A
  /// wire that reaches no target or a closed loop over crossings, which only
  /// a solve that stops early keeps, is not among them.
  connections: [design.Connection] (required);
  /// The outer port ring that the Assignment stage consumes: the configured
  /// ring in its order, without the ring end of each outer bridge where no
  /// inner wire surfaces. The assignment reads this ring and not the
  /// configuration.
  outer_ring: [design.PortRef] (required);
  /// The resonator ports of the chip, and the ring ports where the inner
  /// wire of a resonator surfaces. The Assignment stage treats the ring
  /// nodes among them as resonators.
  resonators: [design.PortRef] (required);
  /// The length of the lattice edges that the connections take, in layout
  /// units.
  objective: double;
}

/// The crossing slots of one partition border.
///
/// A wire leaves one partition for another at one of these, and no two wires
/// take the same one. The slots of one border lie at least one crossing pitch
/// apart, so their count is the most wires that the border can carry, which is
/// what PartitionBorder.budget reports. The crossings of two wires also lie at
/// least one crossing pitch apart, so a wire that crosses another border within
/// one crossing pitch of a slot blocks that slot. The border then carries fewer
/// wires than its budget.
table BorderSlots {
  /// The border they belong to, as an index into CapacityPlan.borders.
  border: uint32;
  /// The slots in layout units, in the order of the walk that picked them.
  /// The walk runs from sample to adjacent sample and starts again at another
  /// end where it runs out, so the order can jump along the border.
  positions: [geometry.Point] (required);
}

/// The coarse route of one connection: which partitions it passes through,
/// and where it crosses from each into the next.
table Corridor {
  /// The labels of the partitions, from the one the wire is fed in to the
  /// one its target sits in. These are Partition.label values, not indices
  /// into CapacityPlan.partitions.
  partitions: [uint32] (required);
  /// The crossing slots between them, in layout units. One shorter than
  /// `partitions`.
  crossings: [geometry.Point] (required);
  /// Where the wire starts: the cell the feed of the assignment was placed
  /// at. Absent when the connection has no feed, when the feed lies off the
  /// grid, or when no partition lies within 8 detail cells of it.
  source: geometry.Point;
  /// Where it ends: the cell its target port is reached at. Absent when the
  /// port has no target cell, or when no partition lies within 8 detail
  /// cells of it.
  target: geometry.Point;
}

/// Output of the Corridor stage.
///
/// One entry per connection of the Assignment, in its order. A connection
/// that the stage could not route carries no partitions, so a reader counts
/// the failures instead of reading a separate list that can disagree with
/// the routes.
table CorridorRouting {
  corridors: [Corridor] (required);
  /// The slots of every border a wire could cross, so that a picture can
  /// show which of them are taken. A border without a crossing slot, whose
  /// budget is zero, has no entry.
  slots: [BorderSlots] (required);
}

/// One wire's path on the detail grid, cell by cell.
///
/// The cells are eight-connected and run from the point the wire is fed at to
/// the cell its target port is reached at. A wire the stage could not draw
/// carries no cells, so a reader counts the failures rather than being handed
/// a separate list that can disagree with the paths beside it.
table DetailWire {
  path: [geometry.DCoord] (required);
}

/// Output of the Detail stage.
///
/// `wires` has one entry per connection of the Assignment, in its order, so it
/// lines up with `CorridorRouting.corridors` without a key. `inner` has one
/// entry per connection of the Global stage, in its order: those never entered
/// the corridor stage, because they paid for the free space they cross while
/// the inner circuit was solved.
table DetailRouting {
  /// The grid the cells are counted on, so a reader can place them without
  /// rebuilding the run.
  grid: GridExtent (required);
  wires: [DetailWire] (required);
  inner: [DetailWire] (required);
}

/// The verdicts the Final stage holds against one wire at its end, as bit
/// flags: a wire can be open and off its length at once. Counted by the
/// stage's own test, the one its last log line reports, with every wire down.
enum FinalVerdict : ubyte (bit_flags) {
  /// The wire has no way of its own: still on its seed, or not on the grid.
  Unrouted,
  /// Its way comes within the wire clearance of another wire.
  Open,
  /// It crosses a feedline edge other than at a right angle, or enters the
  /// room around a feedline's bend.
  Crossing,
  /// A resonator shorter than its target length allows.
  Short,
  /// A resonator longer than its target length allows.
  Long,
  /// Its way crosses or touches itself.
  Loop,
  /// A feedline edge that leaves too little room beside it, at the coupler
  /// insertion, for the wires that have to pass between it and the nearest
  /// qubit or coupler: a bottleneck the feedline pass then fails in. Set on
  /// the snapshots from the coupler insertion on; `note` says where.
  Squeezed,
}

/// One wire's path on the router grid, cell by cell.
///
/// The cells run from the point the wire is fed at to the cell its target port
/// is reached at, and each one carries the heading the search held in it, so
/// the bend structure survives into the geometry. A wire the stage could not
/// draw carries no cells, so a reader counts the failures rather than being
/// handed a separate list that can disagree with the paths beside it.
table FinalWire {
  path: [geometry.RCoord] (required);
  /// How long the path is, in layout units, as the stage renders it: the
  /// exact curves of its bends and not the cells they sweep. Zero for a wire
  /// that carries no cells. The Final stage lengthens a resonator's way to
  /// the target length with a meander, and this is the figure it measured.
  length: double;
  /// What the stage held against the wire when it ended, as the bits of
  /// `FinalVerdict`; zero for a wire nothing was held against. Set on the
  /// end state only — the phase snapshots carry zero, because they are not
  /// judged — so that a renderer can mark the wires the stage left failing
  /// without re-deriving the stage's own count.
  verdict: FinalVerdict;
  /// What the stage says about the wire in words, for a picture's tooltip:
  /// the figures behind a `Squeezed` verdict, say. Empty for most wires.
  note: string;
  /// Cells of a line the stage draws beside the wire to show what `note`
  /// measured: for a `Squeezed` edge the two ends of the line from the
  /// edge to the wall of its channel, the worst line it found. Empty for
  /// most wires.
  marks: [geometry.RCoord];
}

/// What the Final stage had drawn at the end of one of its phases.
///
/// The stage runs five phases and each changes what the phase before it
/// produced: the coupler insertion cuts a resonator back to its coupler, and
/// the feedline passes re-route wires that are already drawn. A picture of one
/// phase therefore cannot be derived from the end state, so each phase leaves
/// its own snapshot here and the renderers draw the one they are asked for. A
/// phase that has not been implemented yet carries no wires.
table FinalPhase {
  /// "pre-feedline-routing", "pre-feedline-refinement", "feedline-insertion",
  /// "feedline-constrained-routing" or "feedline-constrained-refinement".
  name: string (required);
  wires: [FinalWire] (required);
  inner: [FinalWire] (required);
  feedlines: [FinalWire] (required);
  couplers: [design.CpwCoupler] (required);
}

/// Output of the Final stage. The couplers carry the ports they create and
/// the connections they complete, so a reloaded run can rebuild the grown
/// port list and the completed connections without the stage.
table FinalRouting {
  /// The router grid the cells are counted on, so a reader can place them
  /// without rebuilding the run.
  grid: GridExtent (required);
  /// One entry per connection of the Assignment, in its order, so it lines up
  /// with `DetailRouting.wires` without a key.
  wires: [FinalWire] (required);
  /// One entry per connection of the Global stage, in its order.
  inner: [FinalWire] (required);
  /// The edges of the feedline chains, in chain order. An edge that was not
  /// drawn carries no cells.
  feedlines: [FinalWire] (required);
  /// What each entry of `feedlines` runs between, parallel to it.
  feedline_edges: [FeedlineEdge] (required);
  /// What the stage had drawn at the end of each of its phases.
  phases: [FinalPhase] (required);
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
  /// The connections that did not route.
  unresolved: [design.ConnectionRef] (required);
}

/// One edge of a feedline chain: what it runs between and how it is treated.
table FeedlineEdge {
  /// The chain of the Assignment it belongs to.
  chain: uint32;
  /// The ports the edge runs between: a launcher of the chip, or the port a
  /// coupler created, which is the coupler's own `ResonatorSource` port.
  from: design.PortRef (required, native_inline);
  to: design.PortRef (required, native_inline);
  /// Whether the edge starts or ends at a launcher. Such an edge is a hard
  /// obstacle for every wire and the clearance rule checks it; an edge from
  /// one coupler to the next is crossed by the wires between them, at a
  /// right angle, and the clearance rule leaves it out.
  terminal: bool;
}


/// One connection's wire in its exact analytic form.
table Wire {
  connection: design.ConnectionRef (required, native_inline);
  path: geometry.Path (required);
}

/// Output of the Finalize stage: the geometry IR.
table Geometry {
  wires: [Wire] (required);
  couplers: [design.CpwCoupler] (required);
  bridges: [design.Bridge] (required);
}

/// What a stage produces.
union StageOutput {
  CapacityPlan,
  Assignment,
  GlobalRouting,
  DetailRouting,
  FinalRouting,
  Geometry,
  CorridorRouting,
}

/// The root of every stage artifact.
table Artifact {
  /// The mqt-scpd version that wrote the artifact, for provenance.
  producer: string (required);
  output: StageOutput (required);
}

root_type Artifact;

// The identifier records the schema version. Change the digit on an
// incompatible schema change, so that loading an artifact written by an
// incompatible version fails with a clear message rather than misreading it.
file_identifier "SCP1";
file_extension "fb";
