// The six stage artifacts of a run directory, 01-capacity.fb through
// 06-geometry.fb. Owned by MQT::ScpdIO. Grids and router containers are
// derived state and never appear here. See docs/design/pipeline.md.

include "design.fbs";

namespace mqt.scpd.generated;

/// A region of free space on the coarse grid, produced by the watershed.
table Partition {
  id: uint32;
  cells: [GCoord] (required);
}

/// The border between two partitions and the number of wires it may carry.
table Border {
  first: uint32;
  second: uint32;
  budget: uint32;
  bottleneck: bool;
}

/// A corridor of partitions that a group of wires routes along.
table CapacityChain {
  ports: [PortRef] (required);
  /// Partition ids, in routing order.
  partitions: [uint32] (required);
}

/// Output of the Capacity stage.
table CapacityPlan {
  partitions: [Partition] (required);
  borders: [Border] (required);
  chains: [CapacityChain] (required);
}

/// A launcher-to-launcher feedline chain and the resonators it feeds, in
/// ring order.
table Feedline {
  source: PortRef (native_inline);
  target: PortRef (native_inline);
  resonators: [PortRef] (required);
}

/// Output of the Assignment stage.
table Assignment {
  connections: [Connection] (required);
  feedlines: [Feedline] (required);
  objective: double;
}

/// One connection's route on the Hanan lattice of its capacity chain.
table LatticeRoute {
  /// Index into Assignment.connections.
  connection: uint32;
  points: [Point] (required);
}

/// Output of the Global stage. Empty when the chip has no inner circuit.
table GlobalRouting {
  routes: [LatticeRoute] (required);
}

/// One connection's path on the detail grid.
table PixelPath {
  /// Index into Assignment.connections.
  connection: uint32;
  pixels: [DCoord] (required);
}

/// Output of the Detail stage.
table DetailRouting {
  wires: [PixelPath] (required);
}

/// One connection's Dubins path as router states.
table CellPath {
  /// Index into Assignment.connections.
  connection: uint32;
  states: [RCoord] (required);
}

/// Output of the Final stage.
table FinalRouting {
  wires: [CellPath] (required);
  couplers: [CpwCoupler] (required);
  bridges: [Bridge] (required);
  /// Indices into Assignment.connections that did not route.
  unresolved: [uint32] (required);
}

/// One connection's wire in its exact analytic form.
table Wire {
  /// Index into Assignment.connections.
  connection: uint32;
  path: Path (required);
}

/// Output of the Finalize stage: the geometry IR.
table Geometry {
  wires: [Wire] (required);
  couplers: [CpwCoupler] (required);
  bridges: [Bridge] (required);
}

/// What a stage produces.
union StageOutput {
  CapacityPlan,
  Assignment,
  GlobalRouting,
  DetailRouting,
  FinalRouting,
  Geometry,
}

/// The root of every stage artifact.
table Artifact {
  /// The mqt-scpd version that wrote the artifact, for provenance.
  producer: string;
  output: StageOutput (required);
}

root_type Artifact;

// The identifier records the schema version. Change the digit on an
// incompatible schema change, so that loading an artifact written by an
// incompatible version fails with a clear message rather than misreading it.
file_identifier "SCP1";
file_extension "fb";
