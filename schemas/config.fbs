// The run configuration, as loaded and validated from config.toml. Owned by
// MQT::ScpdDesign. Scalar defaults here are the defaults the loader applies;
// a shipped configuration carries only what differs from them, except
// [design_rules], which is always written out in full.
//
// The parameters of a stage arrive with the stage that reads them, appended to
// StageParams; the design-rule check appends its own later.

include "design.fbs";

namespace mqt.scpd.flatbuffers.config;

/// One regular expression per role. Every port must match exactly one.
table PortPatterns {
  launcher: string (required);
  resonator: string (required);
  conventional: string (required);
  /// The ports where a wire crosses a component, rather than ends at it.
  /// Optional: a chip whose components carry no crossing declares none.
  /// PortConfig.bridge_pairs says which two of these ports pair.
  bridge_pair: string;
  /// The component a port belongs to, as one capture group over the label.
  /// A port whose label the pattern does not match carries no component.
  component: string;
}

/// One rule that pairs the two ports a wire crosses a component between.
/// Each side is a regular expression with exactly one capture group. Two
/// ports pair when they belong to one component and their captures are equal.
///
/// The pairing is declared rather than measured. Opposite orientation and
/// shortest distance pick the right two ports on the benchmark chips, but
/// they are a property of the artwork and not a statement of intent.
table BridgeRule {
  first: string (required);
  second: string (required);
}

/// The two ordered outer port sequences of the chip. all_outer is the ring
/// the assignment consumes in order; fixed_outer is the subset a run pins, and
/// is only ever read as a set.
table PortSequences {
  all_outer: [string] (required);
  fixed_outer: [string] (required);
}

table PortConfig {
  patterns: PortPatterns (required);
  sequences: PortSequences (required);
  /// How the ports of the bridge_pair pattern pair off, in the order the rules
  /// apply. Empty when the chip declares no bridge ports.
  bridge_pairs: [BridgeRule];
}

table GridParams {
  capacity_cells_x: uint32 = 50;
  /// Zero derives the value from the chip aspect ratio.
  capacity_cells_y: uint32 = 0;
  /// Read by no stage. A blocked border along the edge of the grid walls in
  /// the launchers that sit there. The slots keep the table layout.
  launcher_offset_x: uint32 = 15 (deprecated);
  launcher_offset_y: uint32 = 15 (deprecated);
  /// Cells of the detail grid per cell of the capacity grid, along each axis.
  detail_factor: uint32 = 30;
  /// Every capacity cell is divided into as many router cells as it holds
  /// steps of this size, rounded up, so a router cell is never wider than it.
  /// The prototype passes the same figure to `FinalGrid`'s constructor as
  /// `unit_division_factor`; it comes out as 9.91 to 10.00 layout units on
  /// every benchmark chip, which is what makes the wire spacing 19 cells
  /// everywhere.
  router_cell_size: double = 10.0;
}

/// What the Capacity stage may do.
table CapacityParams {
  /// The implementation, by the name it is registered under. Empty selects
  /// the default.
  planner: string;
  /// A place on the medial axis is a bottleneck only where the free radius
  /// around it is below this many wire pitches. A pitch is one wire spacing
  /// plus one obstacle spacing.
  ///
  /// The default gives the bottleneck count of the research prototype on the
  /// 4-qubit and the 9-qubit chip.
  bottleneck_clearance: double = 1.5;
  /// How far apart the places sit where a wire may cross a partition border,
  /// in layout units.
  ///
  /// It decides how finely a border is divided for the Corridor stage, and so
  /// how many wires PartitionBorder.budget lets through. The Corridor stage
  /// keeps the crossings of two wires at least one crossing pitch apart, also
  /// where two borders meet. The pitch applies to crossings only: a wire may
  /// cross a border closer than one pitch to the target cell or the feed of
  /// another wire. Where a wire runs inside a partition, and the clearance of
  /// the drawn wire, the later routing stages decide.
  ///
  /// The default is the figure of the research prototype: its wire spacing
  /// less 20 layout units.
  crossing_pitch: double = 165.0;
}

/// What the Global stage may do.
table GlobalParams {
  /// The implementation, by the name it is registered under. Empty selects
  /// the default.
  router: string;
  /// Whether an inner wire may cross a component that the outer ring does not
  /// reach, through one of that component's own bridges.
  ///
  /// Off by default. Such a wire enters a coupler that the assignment never
  /// sees and leaves on the far side, so nothing a later stage reads says
  /// where it runs.
  internal_bridges: bool = false;
}

/// What the Assignment stage may do.
table AssignmentParams {
  /// The implementation, by the name it is registered under. Empty selects
  /// the default.
  assigner: string;
  /// How many feedline chain ends the assignment puts on a launcher; every
  /// other chain end is a termination. A figure per chip with no default:
  /// zero means the configuration does not set it.
  launcher_target: uint32 = 0;
}

/// What the Detail stage is allowed to do.
///
/// The clearance the stage keeps between two wires is **not** here. It is
/// derived from `min_wire_spacing` on the detail grid, because a clearance is
/// a length in layout units and a cell count is a property of the grid; the
/// prototype carries the same quantity twice, once computed and once as the
/// literal 6, and the two disagree on every benchmark.
table DetailParams {
  /// The implementation, by the name it is registered under.
  router: string;
  /// How far to either side of its own path a wire may be moved when it is
  /// re-routed across the partition borders, in wire spacings.
  ///
  /// This is the prototype's `K`, and its `K` is 40 cells of the detail grid:
  /// a cell count and therefore not a distance, because one cell is 19 layout
  /// units on the 17-qubit grid and 40 on the 9-qubit one. The same 40 stands
  /// for 760 units on the one and 1600 on the other, which is four wire
  /// spacings there and eight here. Counted in spacings it is the same
  /// distance on all eight chips: room for the wire and for the wires either
  /// side of it to move over by one.
  corridor_spacings: uint32 = 4;
  /// Sweeps over the wire list, alternating forward and backward. A wire that
  /// has been re-routed is left alone; the sweeps exist so that a wire which
  /// found no way through can take the room a later one has not claimed yet.
  ///
  /// The prototype's own figure is 8, and 8 is enough for what it asks: it
  /// holds the clearance between a wire and the two beside it in the ring and
  /// against nothing else. Holding it against every wire is a harder question
  /// and takes more sweeps to settle — measured over the eight benchmarks, 8
  /// sweeps leave 46 places where the rule does not hold and 30 leave three.
  rounds: uint32 = 30;
  /// How many neighbouring wires a failed re-route may let go of, counted
  /// along the sweep direction first and then against it.
  max_relaxation: uint32 = 30;
  /// How far the cost of running close to an obstacle reaches, in layout
  /// units. Zero switches the penalty off.
  ///
  /// A distance and not a cell count, for the same reason as
  /// `corridor_spacings`: the prototype's 6 cells is 114 layout units on the
  /// 17-qubit chip and 240 on the 9-qubit one.
  obstacle_penalty_reach: double = 185.0;
  /// What running right beside an obstacle costs, falling off linearly to
  /// nothing at `obstacle_penalty_reach`. A price per step, against the ten a
  /// step along an axis costs, so it is the same price on every grid.
  obstacle_penalty: uint32 = 10;
  /// How many orders the wires of one partition are tried in before the best
  /// of them is kept. One means the wires are routed in the order they are
  /// given.
  orderings: uint32 = 16;
}

/// What the Final stage is allowed to do.
///
/// No clearance is here, for the reason `DetailParams` gives: a clearance is a
/// length in layout units and a cell count is a property of the grid. The
/// stage keeps `cells_for(min_wire_spacing, router)` between two wires and
/// `cells_for(min_straight_length, router)` as its straight stub, and it bakes
/// `min_obstacle_spacing` into the obstacle mask. The prototype writes all
/// three as the literals 19, 9 and 2, and none of them records a reason.
table FinalParams {
  /// The implementation, by the name it is registered under.
  router: string;
  /// How far to either side of the way it already has a wire may be moved when
  /// it is routed again, in wire spacings.
  ///
  /// The prototype's `outer_expansion` is 200 cells of the router grid in the
  /// drivers that ship, which is 2000 layout units and therefore a different
  /// distance on every chip. Counted in spacings the same number is the same
  /// room everywhere.
  corridor_spacings: uint32 = 11;
  /// The same, for the wires of the inner circuit, which run inside one unit
  /// cell and need far less room.
  inner_corridor_spacings: uint32 = 11;
  /// Sweeps over the wire list, alternating forward and backward. A wire that
  /// has been routed is left alone; the sweeps exist so that a wire which
  /// found no way through can take the room a later one has not claimed yet.
  rounds: uint32 = 30;
  /// The same, for the inner circuit.
  inner_rounds: uint32 = 4;
  /// How many neighbouring wires a failed route may let go of, counted along
  /// the sweep direction.
  max_relaxation: uint32 = 10;
  /// Rounds that route every wire of the ring again against a proximity
  /// price after the outer routing, to widen the room around it. A wire that
  /// does not route keeps the way it had.
  refinement_rounds: uint32 = 2;
  /// The same after the feedline routing, over the ring with the edges of
  /// the chains, under the feedline constraints: the fifth phase of the
  /// stage, the prototype's feedline refinement, and the phase in which a
  /// resonator is finally made its target length.
  ///
  /// **On since 2026-10-05** (user). Over the eight benchmarks it takes the
  /// stage from `bad` 8 to 2 and from 102 resonators off their length to 6,
  /// for about twice the runtime; five of the eight end clean on both
  /// figures. The prototype runs five rounds; two is what was measured.
  /// Zero switches the phase off and leaves the stage where the feedline
  /// routing ends.
  feedline_refinement_rounds: uint32 = 2;
  /// What one eighth turn costs, in hundredths of a cell.
  ///
  /// A price and not a distance, but it is still normalised: a bend costs a
  /// fixed amount while a way's cost grows with the grid, so the prototype had
  /// to retune it per chip from 8000 to 30000. It is quoted here against the
  /// sum of the grid's two extents, as the prototype's own `_norm` fields do,
  /// and multiplied by that sum at the point of use.
  bend_penalty_norm: double = 2.5;
  /// What running beside another wire costs, on the same scale.
  wire_proximity_penalty_norm: double = 0.00125;
  /// What running beside an obstacle costs, on the same scale.
  static_proximity_penalty_norm: double = 0.00033;
  /// How far the cost of running close to an obstacle reaches, in layout
  /// units. Zero switches the penalty off.
  obstacle_penalty_reach: double = 100.0;
  /// The physical size of the coupler body the stage instantiates, in layout
  /// units. The prototype carries it as 20 by 3 cells.
  coupler_length: double = 200.0;
  coupler_height: double = 26.0;
  /// How many times the feedline repair may turn a placed coupler to another
  /// of its options while the feedlines leave fails. The prototype's
  /// `max_repair_rounds`. Zero switches the repair off.
  repair_trials: uint32 = 0;
  /// The band both refinements may redraw a wire in, in wire spacings, as
  /// `corridor_spacings` is for the sweep. A refinement moves a way that
  /// already stands, so it needs less room than a search that finds one, and
  /// its search, its corridor and its room price all grow with the band.
  /// Zero takes `corridor_spacings`.
  refinement_corridor_spacings: uint32 = 6;
  /// How much of `target_resonator_length` is left to run from the centre of
  /// the coupler to the qubit, as a share of that figure. The meander can
  /// lengthen a way but never shorten one, so a coupler cut short of the
  /// figure hands the rest to the meander. A little below one, so that the
  /// way the routing draws again from the coupler, which may run a few cells
  /// longer than the way that was cut, still lands within the tolerance.
  coupler_bias: double = 0.98;
  /// How far below `target_resonator_length` a coupler may leave the
  /// resonator, as a share of that figure. A place that leaves less is
  /// refused. The centred options of `coupler_option_extension` are exempt.
  coupler_max_shortfall: double = 0.30;
  /// How many cells a coupler keeps off every side of the coupler box, the
  /// room the launcher stubs leave open.
  coupler_box_margin_cells: uint32 = 5;
  /// How far an option that leaves the coupler box is moved into it, in
  /// cells on an axis, before the place is given up.
  coupler_shift_cells: uint32 = 20;
  /// How far the option generator copies every plain option, in cells on
  /// each axis: eight copies, moved by this figure in each of the eight
  /// directions, each with its lead joined to the cell of the resonator's way
  /// nearest its tip. A copy whose resonator is then longer than the target
  /// or shorter than `coupler_max_shortfall` allows is refused. With copies
  /// the generator builds no jogs (`jog_options`). The chain search opens a
  /// coupler's copies as it opens its jogs: only when no run of its plain
  /// options reaches past it. 0 makes no copies.
  coupler_copy_cells: uint32 = 0;
  /// How many cells of straight run the coupler's lead keeps beyond
  /// `min_straight_length`, so that the join with the resonator's way has
  /// room to be a turn.
  coupler_lead_margin_cells: uint32 = 5;
  /// How much further than its own stub a launcher keeps the coupler box
  /// away, in layout units.
  launcher_lead: double = 10.0;
  /// The offsets the option generator turns a pad by, off the heading the
  /// resonator leaves on, as a comma list of eighth turns 0 to 7. Empty
  /// means the default: every offset but 3 and 4, the pad turned 135 and
  /// 180 degrees against the way.
  coupler_offsets: string;
  /// How many cells beyond the launcher's run and the clearance a feedline
  /// edge keeps closed in front of every launcher but its own.
  edge_launcher_margin_cells: uint32 = 6;
  /// The slot a feedline edge keeps open at a coupler's feedline port: the
  /// straight run it is forced to make off the port, in cells.
  terminal_slot_cells: uint32 = 20;
  /// The weight of an edge between a launcher and the coupler beside it in
  /// the chain search, against 1 for every other edge.
  chain_end_edge_weight: double = 0.1;
  /// The bend price of a feedline edge, as a factor on `bend_penalty_norm`.
  edge_bend_factor: double = 1.0;
  /// The price of one cell of length in the chain search; 0 prices length
  /// not at all.
  chain_length_weight: uint32 = 0;
  /// Whether the coupler insertion runs the capacity graph check: the step
  /// checks of the chain search, the whole-chip check after the commit and
  /// the global SAT search when that check says UNSAT. Off, the chains are
  /// settled by cost alone.
  capacity_check: bool = true;
  /// The length-point clearance of the outer routing: the radius, in cells,
  /// a wire keeps from the band of a resonator where that resonator reaches
  /// its target length, and the half-width of that band as a percentage of
  /// the target length. A radius of 0 turns the clearance off.
  length_point_radius_cells: uint32 = 40;
  length_point_band_percent: double = 10.0;
  /// The band of lengths the feedline sweep accepts around the target
  /// length, as a multiple of `resonator_length_tolerance`. One holds the
  /// sweep to the length the refinement holds it to.
  sweep_length_band: double = 1.0;
  /// The spacing of the meander's legs, in cells.
  meander_leg_spacing_cells: uint32 = 25;
  /// How many straight cells at the start of a resonator the meander leaves
  /// as they are; a negative value means the straight run of the lead off
  /// the coupler.
  meander_start_margin_cells: int32 = -1;
  /// The slot check: the safety factor on the clearance a wire takes in a
  /// gap, from the gap size (in wires) the factor applies to; the narrowest
  /// gap a resonator passes, as a share of the clearance.
  capacity_margin: double = 1.06;
  capacity_margin_from_wires: uint32 = 3;
  resonator_passage: double = 0.8;
  /// The band of cells beside a feedline edge where a wire may only cross
  /// at a right angle, the spacing of the crossing points in clearances,
  /// the cells closed at the ends of an edge, the straight run after an
  /// escape turn and the clearance an escape keeps from a stub.
  crossing_reach_cells: uint32 = 10;
  crossing_spacing: double = 1.4142135623730951;
  slot_pin_cells: uint32 = 10;
  escape_straight_cells: uint32 = 5;
  escape_stub_margin_cells: uint32 = 4;
  /// The bottleneck analysis: the widest gap, in wires, still treated as a
  /// bottleneck, and the least rise of a narrowing.
  bottleneck_wires: uint32 = 10;
  bottleneck_rise: double = 2.0;
  /// The room rules: the dead length at both ends of a straight run and the
  /// reach of the channel rule, in cells; the detour a wire may take through
  /// a gap, as a factor on the direct way.
  room_margin_cells: uint32 = 10;
  room_channel_reach_cells: uint32 = 80;
  detour_factor: double = 1.5;
  /// How far a terminal edge's run is guarded past the coupler's pad, in
  /// cells.
  terminal_stub_extra_cells: uint32 = 5;
  /// The budgets of the global SAT search: option runs per segment, locally
  /// SAT states kept per chain and whole-chip combinations tried.
  global_sat_runs: uint32 = 8;
  global_sat_states: uint32 = 8;
  global_sat_tries: uint32 = 200;
  /// How many steps the capacity rule may refuse before a run of options
  /// joins a chain; then the chain is searched again without the rule.
  chain_rule_refusals: uint32 = 1500;
  /// Whether the chain search keeps a blacklist of the pairs of options of
  /// the two couplers at each end of a chain that close the wires there,
  /// and drops a later step on such a pair unchecked.
  chain_end_blacklist: bool = true;
  /// Whether the chain search keeps a blacklist of the pairs of options
  /// whose edge gets fewer crossing slots than wires must cross it, and
  /// drops a later step on such a pair unchecked.
  chain_slot_blacklist: bool = true;
  /// The targeted repair: how many ring members beside a segment are drawn
  /// again and how many local rip-up rounds it runs.
  research_ring_members: uint32 = 2;
  research_rounds: uint32 = 4;
  /// How many ring neighbours to either side a wire is fenced against in
  /// the feedline pass and the refinements.
  fence_pairs: uint32 = 3;
  /// The halo of a wire let go of in a relaxation: its reach in clearances,
  /// and past the wire, in the feedline pass, a price rising to `rise_peak`
  /// times the flat price at `rise_reach` clearances.
  halo_reach: uint32 = 1;
  rise_reach: uint32 = 3;
  rise_peak: uint32 = 3;
  /// Whether a resonator whose way has no room for its meander goes into the
  /// relaxation, as a wire with no way does: the neighbours are let go of one
  /// level at a time until a way long enough is found. Off, the resonator
  /// keeps the short way and lets no neighbour go.
  meander_relaxation: bool = true;
  /// The jogs a coupler option may take, as a comma list of lengths in
  /// cells. A jog is the second dogleg in front of the pad: it moves the pad
  /// sideways off the resonator's way, and every length is tried turned to
  /// either side. Empty takes the one jog of 20 cells.
  jog_options: string;
  /// Where the option generator adds centred coupler options, as a comma
  /// list of cells along the resonator's way from the place nearest the
  /// target length, toward the qubit (a negative entry back from the qubit).
  /// A centred option has the pad's centre on the resonator's way at that
  /// cell, for every allowed offset and both ports. `0,20` adds them at the
  /// place and twenty cells further along. The plain options stay as they
  /// are. Empty adds none. `coupler_max_shortfall` does not refuse them. The
  /// chain search opens a coupler's centred options only when no run reaches
  /// past it with its jogs open.
  coupler_option_extension: string;
  /// How the coupler insertion searches the options of a chain: "astar"
  /// (empty is the same) grows the prefixes of the chain from its first
  /// waypoint; "bidirectional" grows the suffixes from its last waypoint as
  /// well, one priced step each in turn, and lays the run of a prefix and a
  /// suffix that meet on an option again from the front. The search from the
  /// front decides the answer either way.
  chain_search: string;
  /// Whether the option generator adds line options: per coupler, options
  /// whose feedline ports lie on the chord of its two neighbours or on the
  /// line that fits its whole chain best, each turned to the nearest of the
  /// eight headings, at a cut of the resonator
  /// within `length_point_band_percent` of the target length. They are open
  /// from the start, and `coupler_max_shortfall` does not refuse them.
  coupler_line_options: bool = false;
}

/// How the mixed-integer programs of the planning stages are solved.
table SolverParams {
  /// "highs" or "gurobi". Empty means "highs". The environment variable
  /// SCPD_SOLVER overrides it for one run.
  backend: string;
  /// Seconds one solve may take, or zero for no limit.
  time_limit: double = 0.0;
  /// The relative gap a solve may stop at, or zero for the backend's own.
  relative_gap: double = 0.0;
  /// The threads one solve may use, or zero for the backend's own default.
  /// At most 1024, the upper limit of the Gurobi parameter Threads.
  threads: uint32 = 0;
}

/// What the Corridor stage may do.
table CorridorParams {
  /// The implementation, by the name it is registered under. Empty selects
  /// the default.
  router: string;
  /// Sweeps over the connections, alternating forward and backward.
  ///
  /// The sweeps exist so that a connection without a way can take room that
  /// a later one has not claimed yet, and so that the order of the
  /// connections does not decide the result on its own. A sweep can take a
  /// way from a connection that had one; the stage keeps the round with the
  /// fewest connections without a way. One last pass then offers every
  /// connection still without a way the free slots of that round, and rips
  /// up nothing. It must be at least one.
  rounds: uint32 = 12;
  /// How many neighboring connections a failed one may rip up in a sweep,
  /// counted along the sweep direction, and how many wires in its way it may
  /// move aside. The step that moves them also raises the price of the slots
  /// in the way of the failed connection that another wire holds, so with
  /// zero no price rises. The stage uses a value below half the number of
  /// connections, however many this asks for, but at least one when there
  /// are two or more connections.
  max_relaxation: uint32 = 4;
}

/// The parameters of the stages that are implemented.
table StageParams {
  capacity: CapacityParams;
  global: GlobalParams;
  assignment: AssignmentParams;
  solver: SolverParams;
  corridor: CorridorParams;
  detail: DetailParams;
  final: FinalParams;
}

/// How far a run goes.
table RunParams {
  /// The last step to run: a stage, or a phase of a stage. Empty runs every
  /// step this release implements. The command line can override it.
  stop_after: string;
}

/// The pages a run writes under `<run>/debug`, each off unless asked for.
/// The Final stage emits the records a page needs and nothing else; the
/// pages are built from the records when the stage ends, and again by
/// `mqt-scpd debug <run>`.
table DebugParams {
  /// Write `<run>/debug/index.html`, which links every page below and
  /// lists what each phase came to.
  html: bool = false;
  /// A table of the pre-feedline routing: for every wire and round, what the
  /// search came to and at which relaxation level, with the way it found.
  pre_feedline_routing_dashboard: bool = false;
  /// The same table for the pre-feedline refinement.
  pre_feedline_refinement_dashboard: bool = false;
  /// The coupler options and the capacity graph of the feedline insertion,
  /// on the page the graph is laid out on.
  feedline_insertion: bool = false;
  /// Every step check of the chain search: the chain, the step, the options
  /// it stands on, the verdict and the wires it closes.
  local_sat: bool = false;
  /// The global SAT search: the states collected per chain, every
  /// combination tried with its verdict, and the state the chip stands on.
  global_sat: bool = false;
  /// The table for the feedline-constrained routing.
  feedline_constrained_routing_dashboard: bool = false;
  /// The table for the feedline-constrained refinement.
  feedline_constrained_refinement_dashboard: bool = false;
}

/// The whole run configuration.
table Config {
  /// The chip input path, relative to the configuration file.
  chip_input: string (required);
  ports: PortConfig (required);
  rules: design.DesignRules (required);
  grid: GridParams;
  stages: StageParams;
  run: RunParams;
  debug: DebugParams;
}
