// The geometry vocabulary: the layout-space point, the three grid coordinate
// types, polygons, and paths built from analytic segments. Owned by
// MQT::ScpdGeometry.

namespace mqt.scpd.flatbuffers.geometry;

/// A point in layout space. Micrometers, as double.
struct Point {
  x: double;
  y: double;
}

/// A cell of the coarse capacity grid.
struct GCoord {
  x: uint32;
  y: uint32;
}

/// A pixel of the detail grid.
struct DCoord {
  x: uint32;
  y: uint32;
}

/// A state of the router grid: a cell of the final grid and the eight-way
/// heading 0..7 of the wire in it. A wire leaves a heading-0 state toward
/// negative y, and the headings continue clockwise in eighth turns when y
/// points up: heading 2 travels toward negative x, heading 4 toward positive
/// y, heading 6 toward positive x.
struct RCoord {
  x: uint32;
  y: uint32;
  heading: ubyte;
}

/// A closed polygon in layout space, stored as the input carries it.
table Polygon {
  vertices: [Point] (required);
}

/// A straight segment in layout space.
table Line {
  start: Point (required, native_inline);
  end: Point (required, native_inline);
}

/// A circular arc in layout space with an exact center and radius. Angles are
/// radians; a positive sweep runs counter-clockwise.
table Arc {
  center: Point (required, native_inline);
  radius: double;
  start_angle: double;
  sweep: double;
}

/// The two analytic shapes a routed wire consists of.
union SegmentShape {
  Line,
  Arc,
}

/// One analytic segment of a path.
table Segment {
  shape: SegmentShape (required);
}

/// A routed wire as a sequence of analytic segments, never as sampled points.
table Path {
  segments: [Segment] (required);
}
