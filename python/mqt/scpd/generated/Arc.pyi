from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Arc(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Arc: ...
  @classmethod
  def GetRootAsArc(cls, buf: bytes, offset: int) -> Arc: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Centre(self) -> Point | None: ...
  def Radius(self) -> float: ...
  def StartAngle(self) -> float: ...
  def Sweep(self) -> float: ...
class ArcT(object):
  centre: PointT | None
  radius: float
  startAngle: float
  sweep: float
  def __init__(
    self,
    centre: 'PointT' | None = ...,
    radius: float = ...,
    startAngle: float = ...,
    sweep: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ArcT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ArcT: ...
  @classmethod
  def InitFromObj(cls, arc: Arc) -> ArcT: ...
  def _UnPack(self, arc: Arc) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ArcStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ArcAddCentre(builder: flatbuffers.Builder, centre: uoffset) -> None: ...
def ArcAddRadius(builder: flatbuffers.Builder, radius: float) -> None: ...
def ArcAddStartAngle(builder: flatbuffers.Builder, startAngle: float) -> None: ...
def ArcAddSweep(builder: flatbuffers.Builder, sweep: float) -> None: ...
def ArcEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

