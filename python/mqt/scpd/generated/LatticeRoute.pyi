from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class LatticeRoute(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> LatticeRoute: ...
  @classmethod
  def GetRootAsLatticeRoute(cls, buf: bytes, offset: int) -> LatticeRoute: ...
  @classmethod
  def LatticeRouteBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Connection(self) -> int: ...
  def Points(self, i: int) -> Point | None: ...
  def PointsLength(self) -> int: ...
  def PointsIsNone(self) -> bool: ...
class LatticeRouteT(object):
  connection: int
  points: typing.List[PointT]
  def __init__(
    self,
    connection: int = ...,
    points: typing.List['PointT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> LatticeRouteT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> LatticeRouteT: ...
  @classmethod
  def InitFromObj(cls, latticeRoute: LatticeRoute) -> LatticeRouteT: ...
  def _UnPack(self, latticeRoute: LatticeRoute) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def LatticeRouteStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def LatticeRouteAddConnection(builder: flatbuffers.Builder, connection: int) -> None: ...
def LatticeRouteAddPoints(builder: flatbuffers.Builder, points: uoffset) -> None: ...
def LatticeRouteStartPointsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPointsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def LatticeRouteEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

