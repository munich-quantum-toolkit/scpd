from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Polygon import Polygon, PolygonT
from mqt.scpd.generated.Port import Port, PortT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Chip(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Chip: ...
  @classmethod
  def GetRootAsChip(cls, buf: bytes, offset: int) -> Chip: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Obstacles(self, i: int) -> Polygon | None: ...
  def ObstaclesLength(self) -> int: ...
  def ObstaclesIsNone(self) -> bool: ...
  def Ports(self, i: int) -> Port | None: ...
  def PortsLength(self) -> int: ...
  def PortsIsNone(self) -> bool: ...
class ChipT(object):
  obstacles: typing.List[PolygonT]
  ports: typing.List[PortT]
  def __init__(
    self,
    obstacles: typing.List['PolygonT'] | None = ...,
    ports: typing.List['PortT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ChipT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ChipT: ...
  @classmethod
  def InitFromObj(cls, chip: Chip) -> ChipT: ...
  def _UnPack(self, chip: Chip) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ChipStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ChipAddObstacles(builder: flatbuffers.Builder, obstacles: uoffset) -> None: ...
def ChipStartObstaclesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartObstaclesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ChipAddPorts(builder: flatbuffers.Builder, ports: uoffset) -> None: ...
def ChipStartPortsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPortsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def ChipEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

