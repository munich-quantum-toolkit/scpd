from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from flatbuffers import table
from mqt.scpd.generated.Arc import ArcT
from mqt.scpd.generated.Line import LineT
from mqt.scpd.generated.SegmentShape import SegmentShape

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Segment(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Segment: ...
  @classmethod
  def GetRootAsSegment(cls, buf: bytes, offset: int) -> Segment: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def ShapeType(self) -> typing.Literal[SegmentShape.NONE, SegmentShape.Line, SegmentShape.Arc]: ...
  def Shape(self) -> table.Table | None: ...
class SegmentT(object):
  shapeType: typing.Literal[SegmentShape.NONE, SegmentShape.Line, SegmentShape.Arc]
  shape: typing.Union[None, LineT, ArcT]
  def __init__(
    self,
    shapeType: typing.Literal[SegmentShape.NONE, SegmentShape.Line, SegmentShape.Arc] = ...,
    shape: typing.Union[None, LineT, ArcT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> SegmentT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> SegmentT: ...
  @classmethod
  def InitFromObj(cls, segment: Segment) -> SegmentT: ...
  def _UnPack(self, segment: Segment) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def SegmentStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def SegmentAddShapeType(builder: flatbuffers.Builder, shapeType: typing.Literal[SegmentShape.NONE, SegmentShape.Line, SegmentShape.Arc]) -> None: ...
def SegmentAddShape(builder: flatbuffers.Builder, shape: uoffset) -> None: ...
def SegmentEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

