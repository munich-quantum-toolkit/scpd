from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Segment import Segment, SegmentT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Path(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Path: ...
  @classmethod
  def GetRootAsPath(cls, buf: bytes, offset: int) -> Path: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Segments(self, i: int) -> Segment | None: ...
  def SegmentsLength(self) -> int: ...
  def SegmentsIsNone(self) -> bool: ...
class PathT(object):
  segments: typing.List[SegmentT]
  def __init__(
    self,
    segments: typing.List['SegmentT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PathT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PathT: ...
  @classmethod
  def InitFromObj(cls, path: Path) -> PathT: ...
  def _UnPack(self, path: Path) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PathStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PathAddSegments(builder: flatbuffers.Builder, segments: uoffset) -> None: ...
def PathStartSegmentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartSegmentsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def PathEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

