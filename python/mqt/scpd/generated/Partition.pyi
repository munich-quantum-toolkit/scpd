from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.GCoord import GCoord, GCoordT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Partition(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Partition: ...
  @classmethod
  def GetRootAsPartition(cls, buf: bytes, offset: int) -> Partition: ...
  @classmethod
  def PartitionBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Id(self) -> int: ...
  def Cells(self, i: int) -> GCoord | None: ...
  def CellsLength(self) -> int: ...
  def CellsIsNone(self) -> bool: ...
class PartitionT(object):
  id: int
  cells: typing.List[GCoordT]
  def __init__(
    self,
    id: int = ...,
    cells: typing.List['GCoordT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PartitionT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PartitionT: ...
  @classmethod
  def InitFromObj(cls, partition: Partition) -> PartitionT: ...
  def _UnPack(self, partition: Partition) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PartitionStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PartitionAddId(builder: flatbuffers.Builder, id: int) -> None: ...
def PartitionAddCells(builder: flatbuffers.Builder, cells: uoffset) -> None: ...
def PartitionStartCellsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartCellsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def PartitionEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

