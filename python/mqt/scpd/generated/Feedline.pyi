from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.PortRef import PortRef, PortRefT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Feedline(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Feedline: ...
  @classmethod
  def GetRootAsFeedline(cls, buf: bytes, offset: int) -> Feedline: ...
  @classmethod
  def FeedlineBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Source(self) -> PortRef | None: ...
  def Target(self) -> PortRef | None: ...
  def Resonators(self, i: int) -> PortRef | None: ...
  def ResonatorsLength(self) -> int: ...
  def ResonatorsIsNone(self) -> bool: ...
class FeedlineT(object):
  source: PortRefT | None
  target: PortRefT | None
  resonators: typing.List[PortRefT]
  def __init__(
    self,
    source: 'PortRefT' | None = ...,
    target: 'PortRefT' | None = ...,
    resonators: typing.List['PortRefT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FeedlineT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FeedlineT: ...
  @classmethod
  def InitFromObj(cls, feedline: Feedline) -> FeedlineT: ...
  def _UnPack(self, feedline: Feedline) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FeedlineStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FeedlineAddSource(builder: flatbuffers.Builder, source: uoffset) -> None: ...
def FeedlineAddTarget(builder: flatbuffers.Builder, target: uoffset) -> None: ...
def FeedlineAddResonators(builder: flatbuffers.Builder, resonators: uoffset) -> None: ...
def FeedlineStartResonatorsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartResonatorsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def FeedlineEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

