from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT
from mqt.scpd.generated.Rotation import Rotation

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Bridge(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Bridge: ...
  @classmethod
  def GetRootAsBridge(cls, buf: bytes, offset: int) -> Bridge: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Centre(self) -> Point | None: ...
  def Rotation(self) -> typing.Literal[Rotation.R0, Rotation.R45, Rotation.R90, Rotation.R135, Rotation.R180, Rotation.R225, Rotation.R270, Rotation.R315]: ...
  def Width(self) -> float: ...
  def Height(self) -> float: ...
class BridgeT(object):
  centre: PointT | None
  rotation: typing.Literal[Rotation.R0, Rotation.R45, Rotation.R90, Rotation.R135, Rotation.R180, Rotation.R225, Rotation.R270, Rotation.R315]
  width: float
  height: float
  def __init__(
    self,
    centre: 'PointT' | None = ...,
    rotation: typing.Literal[Rotation.R0, Rotation.R45, Rotation.R90, Rotation.R135, Rotation.R180, Rotation.R225, Rotation.R270, Rotation.R315] = ...,
    width: float = ...,
    height: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> BridgeT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> BridgeT: ...
  @classmethod
  def InitFromObj(cls, bridge: Bridge) -> BridgeT: ...
  def _UnPack(self, bridge: Bridge) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def BridgeStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def BridgeAddCentre(builder: flatbuffers.Builder, centre: uoffset) -> None: ...
def BridgeAddRotation(builder: flatbuffers.Builder, rotation: typing.Literal[Rotation.R0, Rotation.R45, Rotation.R90, Rotation.R135, Rotation.R180, Rotation.R225, Rotation.R270, Rotation.R315]) -> None: ...
def BridgeAddWidth(builder: flatbuffers.Builder, width: float) -> None: ...
def BridgeAddHeight(builder: flatbuffers.Builder, height: float) -> None: ...
def BridgeEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

