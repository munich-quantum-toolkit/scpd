from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Polygon(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Polygon: ...
  @classmethod
  def GetRootAsPolygon(cls, buf: bytes, offset: int) -> Polygon: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Vertices(self, i: int) -> Point | None: ...
  def VerticesLength(self) -> int: ...
  def VerticesIsNone(self) -> bool: ...
class PolygonT(object):
  vertices: typing.List[PointT]
  def __init__(
    self,
    vertices: typing.List['PointT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PolygonT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PolygonT: ...
  @classmethod
  def InitFromObj(cls, polygon: Polygon) -> PolygonT: ...
  def _UnPack(self, polygon: Polygon) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PolygonStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PolygonAddVertices(builder: flatbuffers.Builder, vertices: uoffset) -> None: ...
def PolygonStartVerticesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartVerticesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def PolygonEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

