from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Border(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Border: ...
  @classmethod
  def GetRootAsBorder(cls, buf: bytes, offset: int) -> Border: ...
  @classmethod
  def BorderBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def First(self) -> int: ...
  def Second(self) -> int: ...
  def Budget(self) -> int: ...
  def Bottleneck(self) -> bool: ...
class BorderT(object):
  first: int
  second: int
  budget: int
  bottleneck: bool
  def __init__(
    self,
    first: int = ...,
    second: int = ...,
    budget: int = ...,
    bottleneck: bool = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> BorderT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> BorderT: ...
  @classmethod
  def InitFromObj(cls, border: Border) -> BorderT: ...
  def _UnPack(self, border: Border) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def BorderStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def BorderAddFirst(builder: flatbuffers.Builder, first: int) -> None: ...
def BorderAddSecond(builder: flatbuffers.Builder, second: int) -> None: ...
def BorderAddBudget(builder: flatbuffers.Builder, budget: int) -> None: ...
def BorderAddBottleneck(builder: flatbuffers.Builder, bottleneck: bool) -> None: ...
def BorderEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

