  def CapacityPlanBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Partitions(self, i: int) -> Partition | None: ...
  def PartitionsLength(self) -> int: ...
  def PartitionsIsNone(self) -> bool: ...
  def Borders(self, i: int) -> Border | None: ...
  def BordersLength(self) -> int: ...
  def BordersIsNone(self) -> bool: ...
  def Chains(self, i: int) -> CapacityChain | None: ...
  def ChainsLength(self) -> int: ...
  def ChainsIsNone(self) -> bool: ...
class CapacityPlanT(object):
  partitions: typing.List[PartitionT]
  borders: typing.List[BorderT]
  chains: typing.List[CapacityChainT]
  def __init__(
    self,
    partitions: typing.List['PartitionT'] | None = ...,
    borders: typing.List['BorderT'] | None = ...,
    chains: typing.List['CapacityChainT'] | None = ...,
  ) -> None: ...
