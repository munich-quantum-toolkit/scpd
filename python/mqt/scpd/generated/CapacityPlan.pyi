  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CapacityPlanT: ...
  @classmethod
  def InitFromObj(cls, capacityPlan: CapacityPlan) -> CapacityPlanT: ...
  def _UnPack(self, capacityPlan: CapacityPlan) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
