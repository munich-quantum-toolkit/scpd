from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.RCoord import RCoord, RCoordT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class CellPath(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> CellPath: ...
  @classmethod
  def GetRootAsCellPath(cls, buf: bytes, offset: int) -> CellPath: ...
  @classmethod
  def CellPathBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Connection(self) -> int: ...
  def States(self, i: int) -> RCoord | None: ...
  def StatesLength(self) -> int: ...
  def StatesIsNone(self) -> bool: ...
class CellPathT(object):
  connection: int
  states: typing.List[RCoordT]
  def __init__(
    self,
    connection: int = ...,
    states: typing.List['RCoordT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> CellPathT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CellPathT: ...
  @classmethod
  def InitFromObj(cls, cellPath: CellPath) -> CellPathT: ...
  def _UnPack(self, cellPath: CellPath) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def CellPathStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def CellPathAddConnection(builder: flatbuffers.Builder, connection: int) -> None: ...
def CellPathAddStates(builder: flatbuffers.Builder, states: uoffset) -> None: ...
def CellPathStartStatesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartStatesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def CellPathEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

