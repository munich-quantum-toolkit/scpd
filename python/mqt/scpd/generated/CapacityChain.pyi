from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.PortRef import PortRef, PortRefT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class CapacityChain(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> CapacityChain: ...
  @classmethod
  def GetRootAsCapacityChain(cls, buf: bytes, offset: int) -> CapacityChain: ...
  @classmethod
  def CapacityChainBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Ports(self, i: int) -> PortRef | None: ...
  def PortsLength(self) -> int: ...
  def PortsIsNone(self) -> bool: ...
  def Partitions(self, i: int) -> typing.List[int]: ...
  def PartitionsAsNumpy(self) -> np.ndarray: ...
  def PartitionsLength(self) -> int: ...
  def PartitionsIsNone(self) -> bool: ...
class CapacityChainT(object):
  ports: typing.List[PortRefT]
  partitions: typing.List[int]
  def __init__(
    self,
    ports: typing.List['PortRefT'] | None = ...,
    partitions: typing.List[int] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> CapacityChainT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> CapacityChainT: ...
  @classmethod
  def InitFromObj(cls, capacityChain: CapacityChain) -> CapacityChainT: ...
  def _UnPack(self, capacityChain: CapacityChain) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def CapacityChainStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def CapacityChainAddPorts(builder: flatbuffers.Builder, ports: uoffset) -> None: ...
def CapacityChainStartPortsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPortsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def CapacityChainAddPartitions(builder: flatbuffers.Builder, partitions: uoffset) -> None: ...
def CapacityChainStartPartitionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPartitionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def CapacityChainEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

