from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.DCoord import DCoord, DCoordT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PixelPath(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PixelPath: ...
  @classmethod
  def GetRootAsPixelPath(cls, buf: bytes, offset: int) -> PixelPath: ...
  @classmethod
  def PixelPathBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Connection(self) -> int: ...
  def Pixels(self, i: int) -> DCoord | None: ...
  def PixelsLength(self) -> int: ...
  def PixelsIsNone(self) -> bool: ...
class PixelPathT(object):
  connection: int
  pixels: typing.List[DCoordT]
  def __init__(
    self,
    connection: int = ...,
    pixels: typing.List['DCoordT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PixelPathT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PixelPathT: ...
  @classmethod
  def InitFromObj(cls, pixelPath: PixelPath) -> PixelPathT: ...
  def _UnPack(self, pixelPath: PixelPath) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PixelPathStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PixelPathAddConnection(builder: flatbuffers.Builder, connection: int) -> None: ...
def PixelPathAddPixels(builder: flatbuffers.Builder, pixels: uoffset) -> None: ...
def PixelPathStartPixelsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartPixelsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def PixelPathEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

