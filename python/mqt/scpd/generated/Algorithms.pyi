from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Algorithms(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Algorithms: ...
  @classmethod
  def GetRootAsAlgorithms(cls, buf: bytes, offset: int) -> Algorithms: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Assigner(self) -> str | None: ...
  def GlobalRouter(self) -> str | None: ...
  def DetailRouter(self) -> str | None: ...
  def FinalRouter(self) -> str | None: ...
class AlgorithmsT(object):
  assigner: str | None
  globalRouter: str | None
  detailRouter: str | None
  finalRouter: str | None
  def __init__(
    self,
    assigner: str | None = ...,
    globalRouter: str | None = ...,
    detailRouter: str | None = ...,
    finalRouter: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AlgorithmsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AlgorithmsT: ...
  @classmethod
  def InitFromObj(cls, algorithms: Algorithms) -> AlgorithmsT: ...
  def _UnPack(self, algorithms: Algorithms) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AlgorithmsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AlgorithmsAddAssigner(builder: flatbuffers.Builder, assigner: uoffset) -> None: ...
def AlgorithmsAddGlobalRouter(builder: flatbuffers.Builder, globalRouter: uoffset) -> None: ...
def AlgorithmsAddDetailRouter(builder: flatbuffers.Builder, detailRouter: uoffset) -> None: ...
def AlgorithmsAddFinalRouter(builder: flatbuffers.Builder, finalRouter: uoffset) -> None: ...
def AlgorithmsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

