  def GetRootAs(cls, buf: bytes, offset: int) -> Artifact: ...
  @classmethod
  def GetRootAsArtifact(cls, buf: bytes, offset: int) -> Artifact: ...
  @classmethod
  def ArtifactBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Producer(self) -> str | None: ...
  def OutputType(self) -> typing.Literal[StageOutput.NONE, StageOutput.CapacityPlan, StageOutput.Assignment, StageOutput.GlobalRouting, StageOutput.DetailRouting, StageOutput.FinalRouting, StageOutput.Geometry]: ...
  def Output(self) -> table.Table | None: ...
class ArtifactT(object):
  producer: str | None
  outputType: typing.Literal[StageOutput.NONE, StageOutput.CapacityPlan, StageOutput.Assignment, StageOutput.GlobalRouting, StageOutput.DetailRouting, StageOutput.FinalRouting, StageOutput.Geometry]
  output: typing.Union[None, CapacityPlanT, AssignmentT, GlobalRoutingT, DetailRoutingT, FinalRoutingT, GeometryT]
  def __init__(
    self,
    producer: str | None = ...,
    outputType: typing.Literal[StageOutput.NONE, StageOutput.CapacityPlan, StageOutput.Assignment, StageOutput.GlobalRouting, StageOutput.DetailRouting, StageOutput.FinalRouting, StageOutput.Geometry] = ...,
    output: typing.Union[None, CapacityPlanT, AssignmentT, GlobalRoutingT, DetailRoutingT, FinalRoutingT, GeometryT] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ArtifactT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ArtifactT: ...
  @classmethod
  def InitFromObj(cls, artifact: Artifact) -> ArtifactT: ...
  def _UnPack(self, artifact: Artifact) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
