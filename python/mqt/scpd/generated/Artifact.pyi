def Start(builder: flatbuffers.Builder) -> None: ...
def ArtifactAddProducer(builder: flatbuffers.Builder, producer: uoffset) -> None: ...
def ArtifactAddOutputType(builder: flatbuffers.Builder, outputType: typing.Literal[StageOutput.NONE, StageOutput.CapacityPlan, StageOutput.Assignment, StageOutput.GlobalRouting, StageOutput.DetailRouting, StageOutput.FinalRouting, StageOutput.Geometry]) -> None: ...
