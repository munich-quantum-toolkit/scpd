from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.PixelPath import PixelPath, PixelPathT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DetailRouting(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DetailRouting: ...
  @classmethod
  def GetRootAsDetailRouting(cls, buf: bytes, offset: int) -> DetailRouting: ...
  @classmethod
  def DetailRoutingBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Wires(self, i: int) -> PixelPath | None: ...
  def WiresLength(self) -> int: ...
  def WiresIsNone(self) -> bool: ...
class DetailRoutingT(object):
  wires: typing.List[PixelPathT]
  def __init__(
    self,
    wires: typing.List['PixelPathT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DetailRoutingT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DetailRoutingT: ...
  @classmethod
  def InitFromObj(cls, detailRouting: DetailRouting) -> DetailRoutingT: ...
  def _UnPack(self, detailRouting: DetailRouting) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DetailRoutingStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DetailRoutingAddWires(builder: flatbuffers.Builder, wires: uoffset) -> None: ...
def DetailRoutingStartWiresVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartWiresVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DetailRoutingEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

