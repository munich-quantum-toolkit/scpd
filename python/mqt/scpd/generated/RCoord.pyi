from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class RCoord(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def X(self) -> int: ...
  def Y(self) -> int: ...
  def Heading(self) -> int: ...
class RCoordT(object):
  x: int
  y: int
  heading: int
  def __init__(
    self,
    x: int = ...,
    y: int = ...,
    heading: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> RCoordT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> RCoordT: ...
  @classmethod
  def InitFromObj(cls, rcoord: RCoord) -> RCoordT: ...
  def _UnPack(self, rcoord: RCoord) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateRCoord(builder: flatbuffers.Builder, x: int, y: int, heading: int) -> uoffset: ...

