from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DrcParams(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DrcParams: ...
  @classmethod
  def GetRootAsDrcParams(cls, buf: bytes, offset: int) -> DrcParams: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def All(self) -> bool: ...
  def ComponentOverlap(self) -> bool: ...
  def MinStraightLength(self) -> bool: ...
  def MinBendRadius(self) -> bool: ...
  def ShortThreshold(self) -> float: ...
  def JunctionRadiusNorm(self) -> float: ...
class DrcParamsT(object):
  all: bool
  componentOverlap: bool
  minStraightLength: bool
  minBendRadius: bool
  shortThreshold: float
  junctionRadiusNorm: float
  def __init__(
    self,
    all: bool = ...,
    componentOverlap: bool = ...,
    minStraightLength: bool = ...,
    minBendRadius: bool = ...,
    shortThreshold: float = ...,
    junctionRadiusNorm: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DrcParamsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DrcParamsT: ...
  @classmethod
  def InitFromObj(cls, drcParams: DrcParams) -> DrcParamsT: ...
  def _UnPack(self, drcParams: DrcParams) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DrcParamsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DrcParamsAddAll(builder: flatbuffers.Builder, all: bool) -> None: ...
def DrcParamsAddComponentOverlap(builder: flatbuffers.Builder, componentOverlap: bool) -> None: ...
def DrcParamsAddMinStraightLength(builder: flatbuffers.Builder, minStraightLength: bool) -> None: ...
def DrcParamsAddMinBendRadius(builder: flatbuffers.Builder, minBendRadius: bool) -> None: ...
def DrcParamsAddShortThreshold(builder: flatbuffers.Builder, shortThreshold: float) -> None: ...
def DrcParamsAddJunctionRadiusNorm(builder: flatbuffers.Builder, junctionRadiusNorm: float) -> None: ...
def DrcParamsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

