from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Path import Path, PathT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Wire(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Wire: ...
  @classmethod
  def GetRootAsWire(cls, buf: bytes, offset: int) -> Wire: ...
  @classmethod
  def WireBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Connection(self) -> int: ...
  def Path(self) -> Path | None: ...
class WireT(object):
  connection: int
  path: PathT | None
  def __init__(
    self,
    connection: int = ...,
    path: 'PathT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> WireT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> WireT: ...
  @classmethod
  def InitFromObj(cls, wire: Wire) -> WireT: ...
  def _UnPack(self, wire: Wire) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def WireStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def WireAddConnection(builder: flatbuffers.Builder, connection: int) -> None: ...
def WireAddPath(builder: flatbuffers.Builder, path: uoffset) -> None: ...
def WireEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

