from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class FinalParams(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> FinalParams: ...
  @classmethod
  def GetRootAsFinalParams(cls, buf: bytes, offset: int) -> FinalParams: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def MeanderLength(self) -> float: ...
  def Expansion(self) -> int: ...
  def Rounds(self) -> int: ...
  def RefinementRounds(self) -> int: ...
class FinalParamsT(object):
  meanderLength: float
  expansion: int
  rounds: int
  refinementRounds: int
  def __init__(
    self,
    meanderLength: float = ...,
    expansion: int = ...,
    rounds: int = ...,
    refinementRounds: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> FinalParamsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> FinalParamsT: ...
  @classmethod
  def InitFromObj(cls, finalParams: FinalParams) -> FinalParamsT: ...
  def _UnPack(self, finalParams: FinalParams) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def FinalParamsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def FinalParamsAddMeanderLength(builder: flatbuffers.Builder, meanderLength: float) -> None: ...
def FinalParamsAddExpansion(builder: flatbuffers.Builder, expansion: int) -> None: ...
def FinalParamsAddRounds(builder: flatbuffers.Builder, rounds: int) -> None: ...
def FinalParamsAddRefinementRounds(builder: flatbuffers.Builder, refinementRounds: int) -> None: ...
def FinalParamsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

