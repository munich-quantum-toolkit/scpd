from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GCoord(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def X(self) -> int: ...
  def Y(self) -> int: ...
class GCoordT(object):
  x: int
  y: int
  def __init__(
    self,
    x: int = ...,
    y: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GCoordT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GCoordT: ...
  @classmethod
  def InitFromObj(cls, gcoord: GCoord) -> GCoordT: ...
  def _UnPack(self, gcoord: GCoord) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateGCoord(builder: flatbuffers.Builder, x: int, y: int) -> uoffset: ...

