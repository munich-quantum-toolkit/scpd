from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT
from mqt.scpd.generated.UnassignedRole import UnassignedRole

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Port(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Port: ...
  @classmethod
  def GetRootAsPort(cls, buf: bytes, offset: int) -> Port: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Label(self) -> str | None: ...
  def Centre(self) -> Point | None: ...
  def Orientation(self) -> float: ...
  def Role(self) -> typing.Literal[UnassignedRole.Launcher, UnassignedRole.Resonator, UnassignedRole.Conventional]: ...
class PortT(object):
  label: str | None
  centre: PointT | None
  orientation: float
  role: typing.Literal[UnassignedRole.Launcher, UnassignedRole.Resonator, UnassignedRole.Conventional]
  def __init__(
    self,
    label: str | None = ...,
    centre: 'PointT' | None = ...,
    orientation: float = ...,
    role: typing.Literal[UnassignedRole.Launcher, UnassignedRole.Resonator, UnassignedRole.Conventional] = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PortT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PortT: ...
  @classmethod
  def InitFromObj(cls, port: Port) -> PortT: ...
  def _UnPack(self, port: Port) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PortStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PortAddLabel(builder: flatbuffers.Builder, label: uoffset) -> None: ...
def PortAddCentre(builder: flatbuffers.Builder, centre: uoffset) -> None: ...
def PortAddOrientation(builder: flatbuffers.Builder, orientation: float) -> None: ...
def PortAddRole(builder: flatbuffers.Builder, role: typing.Literal[UnassignedRole.Launcher, UnassignedRole.Resonator, UnassignedRole.Conventional]) -> None: ...
def PortEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

