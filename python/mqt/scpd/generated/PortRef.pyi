from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PortRef(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def Index(self) -> int: ...
class PortRefT(object):
  index: int
  def __init__(
    self,
    index: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PortRefT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PortRefT: ...
  @classmethod
  def InitFromObj(cls, portRef: PortRef) -> PortRefT: ...
  def _UnPack(self, portRef: PortRef) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreatePortRef(builder: flatbuffers.Builder, index: int) -> uoffset: ...

