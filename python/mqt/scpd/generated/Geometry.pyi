from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Bridge import Bridge, BridgeT
from mqt.scpd.generated.CpwCoupler import CpwCoupler, CpwCouplerT
from mqt.scpd.generated.Wire import Wire, WireT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Geometry(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Geometry: ...
  @classmethod
  def GetRootAsGeometry(cls, buf: bytes, offset: int) -> Geometry: ...
  @classmethod
  def GeometryBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Wires(self, i: int) -> Wire | None: ...
  def WiresLength(self) -> int: ...
  def WiresIsNone(self) -> bool: ...
  def Couplers(self, i: int) -> CpwCoupler | None: ...
  def CouplersLength(self) -> int: ...
  def CouplersIsNone(self) -> bool: ...
  def Bridges(self, i: int) -> Bridge | None: ...
  def BridgesLength(self) -> int: ...
  def BridgesIsNone(self) -> bool: ...
class GeometryT(object):
  wires: typing.List[WireT]
  couplers: typing.List[CpwCouplerT]
  bridges: typing.List[BridgeT]
  def __init__(
    self,
    wires: typing.List['WireT'] | None = ...,
    couplers: typing.List['CpwCouplerT'] | None = ...,
    bridges: typing.List['BridgeT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GeometryT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GeometryT: ...
  @classmethod
  def InitFromObj(cls, geometry: Geometry) -> GeometryT: ...
  def _UnPack(self, geometry: Geometry) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GeometryStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GeometryAddWires(builder: flatbuffers.Builder, wires: uoffset) -> None: ...
def GeometryStartWiresVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartWiresVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GeometryAddCouplers(builder: flatbuffers.Builder, couplers: uoffset) -> None: ...
def GeometryStartCouplersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartCouplersVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GeometryAddBridges(builder: flatbuffers.Builder, bridges: uoffset) -> None: ...
def GeometryStartBridgesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartBridgesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GeometryEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

