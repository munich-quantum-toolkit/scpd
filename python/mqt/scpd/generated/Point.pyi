from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Point(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def X(self) -> float: ...
  def Y(self) -> float: ...
class PointT(object):
  x: float
  y: float
  def __init__(
    self,
    x: float = ...,
    y: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PointT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PointT: ...
  @classmethod
  def InitFromObj(cls, point: Point) -> PointT: ...
  def _UnPack(self, point: Point) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreatePoint(builder: flatbuffers.Builder, x: float, y: float) -> uoffset: ...

