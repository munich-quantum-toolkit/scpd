from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Point import Point, PointT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Line(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Line: ...
  @classmethod
  def GetRootAsLine(cls, buf: bytes, offset: int) -> Line: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Start(self) -> Point | None: ...
  def End(self) -> Point | None: ...
class LineT(object):
  start: PointT | None
  end: PointT | None
  def __init__(
    self,
    start: 'PointT' | None = ...,
    end: 'PointT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> LineT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> LineT: ...
  @classmethod
  def InitFromObj(cls, line: Line) -> LineT: ...
  def _UnPack(self, line: Line) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def LineStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def LineAddStart(builder: flatbuffers.Builder, start: uoffset) -> None: ...
def LineAddEnd(builder: flatbuffers.Builder, end: uoffset) -> None: ...
def LineEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

