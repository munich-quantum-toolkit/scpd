from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.DrcFinding import DrcFinding, DrcFindingT
from mqt.scpd.generated.DrcStage import DrcStage

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DrcReport(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> DrcReport: ...
  @classmethod
  def GetRootAsDrcReport(cls, buf: bytes, offset: int) -> DrcReport: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Stage(self) -> typing.Literal[DrcStage.Final, DrcStage.Finalize]: ...
  def Findings(self, i: int) -> DrcFinding | None: ...
  def FindingsLength(self) -> int: ...
  def FindingsIsNone(self) -> bool: ...
  def FeedlinesSkipped(self) -> int: ...
class DrcReportT(object):
  stage: typing.Literal[DrcStage.Final, DrcStage.Finalize]
  findings: typing.List[DrcFindingT]
  feedlinesSkipped: int
  def __init__(
    self,
    stage: typing.Literal[DrcStage.Final, DrcStage.Finalize] = ...,
    findings: typing.List['DrcFindingT'] | None = ...,
    feedlinesSkipped: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DrcReportT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DrcReportT: ...
  @classmethod
  def InitFromObj(cls, drcReport: DrcReport) -> DrcReportT: ...
  def _UnPack(self, drcReport: DrcReport) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def DrcReportStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def DrcReportAddStage(builder: flatbuffers.Builder, stage: typing.Literal[DrcStage.Final, DrcStage.Finalize]) -> None: ...
def DrcReportAddFindings(builder: flatbuffers.Builder, findings: uoffset) -> None: ...
def DrcReportStartFindingsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFindingsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def DrcReportAddFeedlinesSkipped(builder: flatbuffers.Builder, feedlinesSkipped: int) -> None: ...
def DrcReportEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

