from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class DCoord(object):
  @classmethod
  def SizeOf(cls) -> int: ...

  def Init(self, buf: bytes, pos: int) -> None: ...
  def X(self) -> int: ...
  def Y(self) -> int: ...
class DCoordT(object):
  x: int
  y: int
  def __init__(
    self,
    x: int = ...,
    y: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> DCoordT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> DCoordT: ...
  @classmethod
  def InitFromObj(cls, dcoord: DCoord) -> DCoordT: ...
  def _UnPack(self, dcoord: DCoord) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...

def CreateDCoord(builder: flatbuffers.Builder, x: int, y: int) -> uoffset: ...

