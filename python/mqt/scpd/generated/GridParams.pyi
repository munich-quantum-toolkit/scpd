from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GridParams(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GridParams: ...
  @classmethod
  def GetRootAsGridParams(cls, buf: bytes, offset: int) -> GridParams: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def CapacityCellsX(self) -> int: ...
  def CapacityCellsY(self) -> int: ...
  def LauncherOffsetX(self) -> int: ...
  def LauncherOffsetY(self) -> int: ...
class GridParamsT(object):
  capacityCellsX: int
  capacityCellsY: int
  launcherOffsetX: int
  launcherOffsetY: int
  def __init__(
    self,
    capacityCellsX: int = ...,
    capacityCellsY: int = ...,
    launcherOffsetX: int = ...,
    launcherOffsetY: int = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GridParamsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GridParamsT: ...
  @classmethod
  def InitFromObj(cls, gridParams: GridParams) -> GridParamsT: ...
  def _UnPack(self, gridParams: GridParams) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GridParamsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GridParamsAddCapacityCellsX(builder: flatbuffers.Builder, capacityCellsX: int) -> None: ...
def GridParamsAddCapacityCellsY(builder: flatbuffers.Builder, capacityCellsY: int) -> None: ...
def GridParamsAddLauncherOffsetX(builder: flatbuffers.Builder, launcherOffsetX: int) -> None: ...
def GridParamsAddLauncherOffsetY(builder: flatbuffers.Builder, launcherOffsetY: int) -> None: ...
def GridParamsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

