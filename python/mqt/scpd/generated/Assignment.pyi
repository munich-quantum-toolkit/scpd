from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.Connection import Connection, ConnectionT
from mqt.scpd.generated.Feedline import Feedline, FeedlineT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class Assignment(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> Assignment: ...
  @classmethod
  def GetRootAsAssignment(cls, buf: bytes, offset: int) -> Assignment: ...
  @classmethod
  def AssignmentBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Connections(self, i: int) -> Connection | None: ...
  def ConnectionsLength(self) -> int: ...
  def ConnectionsIsNone(self) -> bool: ...
  def Feedlines(self, i: int) -> Feedline | None: ...
  def FeedlinesLength(self) -> int: ...
  def FeedlinesIsNone(self) -> bool: ...
  def Objective(self) -> float: ...
class AssignmentT(object):
  connections: typing.List[ConnectionT]
  feedlines: typing.List[FeedlineT]
  objective: float
  def __init__(
    self,
    connections: typing.List['ConnectionT'] | None = ...,
    feedlines: typing.List['FeedlineT'] | None = ...,
    objective: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> AssignmentT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> AssignmentT: ...
  @classmethod
  def InitFromObj(cls, assignment: Assignment) -> AssignmentT: ...
  def _UnPack(self, assignment: Assignment) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def AssignmentStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def AssignmentAddConnections(builder: flatbuffers.Builder, connections: uoffset) -> None: ...
def AssignmentStartConnectionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartConnectionsVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AssignmentAddFeedlines(builder: flatbuffers.Builder, feedlines: uoffset) -> None: ...
def AssignmentStartFeedlinesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartFeedlinesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def AssignmentAddObjective(builder: flatbuffers.Builder, objective: float) -> None: ...
def AssignmentEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

