from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class ComponentParams(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> ComponentParams: ...
  @classmethod
  def GetRootAsComponentParams(cls, buf: bytes, offset: int) -> ComponentParams: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def CouplerLength(self) -> float: ...
  def CouplerHeight(self) -> float: ...
  def BridgeWidth(self) -> float: ...
  def BridgeHeight(self) -> float: ...
class ComponentParamsT(object):
  couplerLength: float
  couplerHeight: float
  bridgeWidth: float
  bridgeHeight: float
  def __init__(
    self,
    couplerLength: float = ...,
    couplerHeight: float = ...,
    bridgeWidth: float = ...,
    bridgeHeight: float = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> ComponentParamsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> ComponentParamsT: ...
  @classmethod
  def InitFromObj(cls, componentParams: ComponentParams) -> ComponentParamsT: ...
  def _UnPack(self, componentParams: ComponentParams) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def ComponentParamsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def ComponentParamsAddCouplerLength(builder: flatbuffers.Builder, couplerLength: float) -> None: ...
def ComponentParamsAddCouplerHeight(builder: flatbuffers.Builder, couplerHeight: float) -> None: ...
def ComponentParamsAddBridgeWidth(builder: flatbuffers.Builder, bridgeWidth: float) -> None: ...
def ComponentParamsAddBridgeHeight(builder: flatbuffers.Builder, bridgeHeight: float) -> None: ...
def ComponentParamsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

