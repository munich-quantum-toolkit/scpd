from __future__ import annotations

import flatbuffers
import numpy as np

import typing
from mqt.scpd.generated.LatticeRoute import LatticeRoute, LatticeRouteT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class GlobalRouting(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> GlobalRouting: ...
  @classmethod
  def GetRootAsGlobalRouting(cls, buf: bytes, offset: int) -> GlobalRouting: ...
  @classmethod
  def GlobalRoutingBufferHasIdentifier(cls, buf: bytes, offset: int, size_prefixed: bool) -> bool: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Routes(self, i: int) -> LatticeRoute | None: ...
  def RoutesLength(self) -> int: ...
  def RoutesIsNone(self) -> bool: ...
class GlobalRoutingT(object):
  routes: typing.List[LatticeRouteT]
  def __init__(
    self,
    routes: typing.List['LatticeRouteT'] | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> GlobalRoutingT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> GlobalRoutingT: ...
  @classmethod
  def InitFromObj(cls, globalRouting: GlobalRouting) -> GlobalRoutingT: ...
  def _UnPack(self, globalRouting: GlobalRouting) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def GlobalRoutingStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def GlobalRoutingAddRoutes(builder: flatbuffers.Builder, routes: uoffset) -> None: ...
def GlobalRoutingStartRoutesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def StartRoutesVector(builder: flatbuffers.Builder, num_elems: int) -> uoffset: ...
def GlobalRoutingEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

