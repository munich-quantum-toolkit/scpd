from mqt.scpd.generated.FinalParams import FinalParams, FinalParamsT

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class StageParams(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> StageParams: ...
  @classmethod
  def GetRootAsStageParams(cls, buf: bytes, offset: int) -> StageParams: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Algorithms(self) -> Algorithms | None: ...
  def Assignment(self) -> AssignmentParams | None: ...
  def Final(self) -> FinalParams | None: ...
class StageParamsT(object):
  algorithms: AlgorithmsT | None
  assignment: AssignmentParamsT | None
  final: FinalParamsT | None
  def __init__(
    self,
    algorithms: 'AlgorithmsT' | None = ...,
    assignment: 'AssignmentParamsT' | None = ...,
    final: 'FinalParamsT' | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> StageParamsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> StageParamsT: ...
  @classmethod
  def InitFromObj(cls, stageParams: StageParams) -> StageParamsT: ...
  def _UnPack(self, stageParams: StageParams) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def StageParamsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def StageParamsAddAlgorithms(builder: flatbuffers.Builder, algorithms: uoffset) -> None: ...
def StageParamsAddAssignment(builder: flatbuffers.Builder, assignment: uoffset) -> None: ...
def StageParamsAddFinal(builder: flatbuffers.Builder, final: uoffset) -> None: ...
def StageParamsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

