from __future__ import annotations

import flatbuffers
import numpy as np

import typing

uoffset: typing.TypeAlias = flatbuffers.number_types.UOffsetTFlags.py_type

class PortPatterns(object):
  @classmethod
  def GetRootAs(cls, buf: bytes, offset: int) -> PortPatterns: ...
  @classmethod
  def GetRootAsPortPatterns(cls, buf: bytes, offset: int) -> PortPatterns: ...
  def Init(self, buf: bytes, pos: int) -> None: ...
  def Launcher(self) -> str | None: ...
  def Resonator(self) -> str | None: ...
  def Conventional(self) -> str | None: ...
class PortPatternsT(object):
  launcher: str | None
  resonator: str | None
  conventional: str | None
  def __init__(
    self,
    launcher: str | None = ...,
    resonator: str | None = ...,
    conventional: str | None = ...,
  ) -> None: ...
  @classmethod
  def InitFromBuf(cls, buf: bytes, pos: int) -> PortPatternsT: ...
  @classmethod
  def InitFromPackedBuf(cls, buf: bytes, pos: int = 0) -> PortPatternsT: ...
  @classmethod
  def InitFromObj(cls, portPatterns: PortPatterns) -> PortPatternsT: ...
  def _UnPack(self, portPatterns: PortPatterns) -> None: ...
  def Pack(self, builder: flatbuffers.Builder) -> None: ...
def PortPatternsStart(builder: flatbuffers.Builder) -> None: ...
def Start(builder: flatbuffers.Builder) -> None: ...
def PortPatternsAddLauncher(builder: flatbuffers.Builder, launcher: uoffset) -> None: ...
def PortPatternsAddResonator(builder: flatbuffers.Builder, resonator: uoffset) -> None: ...
def PortPatternsAddConventional(builder: flatbuffers.Builder, conventional: uoffset) -> None: ...
def PortPatternsEnd(builder: flatbuffers.Builder) -> uoffset: ...
def End(builder: flatbuffers.Builder) -> uoffset: ...

